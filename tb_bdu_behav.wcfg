<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_bdu_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_bdu" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="17.001 ns"></ZoomEndTime>
      <Cursor1Time time="17.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="112"></NameColumnWidth>
      <ValueColumnWidth column_width="101"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="12" />
   <wvobject fp_name="divider803" type="divider">
      <obj_property name="label">Branch Flag</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#E0FFFF</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_bdu/branch">
      <obj_property name="ElementShortName">branch</obj_property>
      <obj_property name="ObjectShortName">branch</obj_property>
   </wvobject>
   <wvobject fp_name="divider804" type="divider">
      <obj_property name="label">Branch Condition</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#FFA500</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_bdu/cond">
      <obj_property name="ElementShortName">cond[3:0]</obj_property>
      <obj_property name="ObjectShortName">cond[3:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_bdu/condition_name">
      <obj_property name="ElementShortName">condition_name[63:0]</obj_property>
      <obj_property name="ObjectShortName">condition_name[63:0]</obj_property>
      <obj_property name="Radix">ASCIIRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="divider807" type="divider">
      <obj_property name="label">Source register value</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#FF00FF</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_bdu/rs">
      <obj_property name="ElementShortName">rs[31:0]</obj_property>
      <obj_property name="ObjectShortName">rs[31:0]</obj_property>
      <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="divider806" type="divider">
      <obj_property name="label">Flags</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_bdu/zero">
      <obj_property name="ElementShortName">zero</obj_property>
      <obj_property name="ObjectShortName">zero</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_bdu/taken">
      <obj_property name="ElementShortName">taken</obj_property>
      <obj_property name="ObjectShortName">taken</obj_property>
   </wvobject>
   <wvobject fp_name="divider805" type="divider">
      <obj_property name="label">Debug</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#800000</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_bdu/errors">
      <obj_property name="ElementShortName">errors[31:0]</obj_property>
      <obj_property name="ObjectShortName">errors[31:0]</obj_property>
   </wvobject>
</wave_config>
