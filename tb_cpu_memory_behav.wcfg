<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state />
   <db_ref_list>
      <db_ref path="tb_cpu_memory_behav.wdb" id="1">
         <top_modules>
            <top_module name="tb_cpu_memory" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns" />
      <ZoomEndTime time="180.000 ns" />
      <Cursor1Time time="0.000 ns" />
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="220" />
      <ValueColumnWidth column_width="250" />
   </column_width_setting>
   <WVObjectSize size="25" />
   <wvobject fp_name="divider_cpu_memory_1" type="divider">
      <obj_property name="label">TEST STATUS</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#E0FFFF</obj_property>
   </wvobject>
