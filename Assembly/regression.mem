...                (continue for and, or, slt, lw, sw)

# On success: write pass marker
200A0001          # addi $t2, $zero, 1
AC0A0004          # sw $t2, 4($zero)         → Mem[1] = 1
08000000          # halt: j 0x0000
00000000          # nop