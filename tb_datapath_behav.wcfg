<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_datapath_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_datapath" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="131.001 ns"></ZoomEndTime>
      <Cursor1Time time="113.672 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="225"></NameColumnWidth>
      <ValueColumnWidth column_width="150"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="21" />
   <wvobject fp_name="divider_TEST_AND_CLOCK" type="divider">
      <obj_property name="label">Clock Reset</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="BkColor">#E0FFFF</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_datapath/step">
