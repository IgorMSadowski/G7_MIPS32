<?xml version='1.0' encoding='UTF-8'?>
<wave_config>
   <wave_state />
   <db_ref_list>
      <db_ref path="tb_datapath_behav.wdb" id="1">
         <top_modules>
            <top_module name="tb_datapath" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns" />
      <ZoomEndTime time="160.000 ns" />
      <Cursor1Time time="0.000 ns" />
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="260" />
      <ValueColumnWidth column_width="280" />
   </column_width_setting>
   <WVObjectSize size="21" />
   <wvobject fp_name="divider_TEST_AND_CLOCK" type="divider">
      <obj_property name="label">TEST AND CLOCK</obj_property>
